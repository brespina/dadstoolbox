---
import { text } from '../text';
import { links } from '../links';
import { sitePath } from '../site/paths';

const promisePath = sitePath('promise');
---

<footer class="site-footer">
  <nav aria-label={text.footer.label}>
    <ul>
      <li>
        <a href={promisePath}>{text.footer.promise}</a>
      </li>
      <li>
        <a href={links.reportProblem}>{text.reportProblem}</a>
      </li>
      <li>
        <a href={links.sponsor}>{text.footer.sponsor}</a>
      </li>
    </ul>
  </nav>
</footer>
