---
import SiteLayout from '../layouts/SiteLayout.astro';
import { fillText, text } from '../text';
import { credits } from '../site/credits';

const t = text.creditsPage;
// "(MIT AND Zlib)" reads better without the brackets.
const licenseName = (license: string) => license.replace(/^\((.*)\)$/, '$1');
// partOf is an npm package; show the name its makers use, such as "Astro".
const nameOf = (pkg: string) => credits.find((credit) => credit.package === pkg)?.name ?? pkg;
---

<SiteLayout title={t.title} description={t.description}>
  <h1>{t.heading}</h1>
  <p>{t.intro}</p>
  <p>{t.unchanged}</p>

  <ul class="credits">
    {credits.map((credit) => (
      <li>
        <h2>{credit.name}</h2>
        <p>
          {credit.does}
          {credit.partOf && ` ${fillText(t.partOf, { name: nameOf(credit.partOf) })}`}
        </p>
        <p>
          {credit.version && `${fillText(t.version, { version: credit.version })} `}
          {fillText(t.license, { license: licenseName(credit.license) })}
        </p>
        <ul class="link-list">
          <li>
            <a href={credit.codeUrl}>{fillText(t.codeLink, { name: credit.name })}</a>
          </li>
          <li>
            <a href={credit.licenseUrl}>{fillText(t.licenseLink, { name: credit.name })}</a>
          </li>
        </ul>
      </li>
    ))}
  </ul>
</SiteLayout>

<style>
  .credits {
    list-style: none;
    padding: 0;
  }

  .credits > li + li {
    margin-top: 1.5rem;
  }

  .credits h2 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .credits p {
    margin: 0.25rem 0;
  }
</style>
