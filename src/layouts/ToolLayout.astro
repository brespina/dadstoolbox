---
// The shared Tool page. A Tool's own page is one line: <ToolLayout address="…" />.
import SiteLayout from './SiteLayout.astro';
import ToolPage from '../components/ToolPage.svelte';
import { toolAt } from '../tools/registry';
import { fillText, text } from '../text';
import { sitePath } from '../site/paths';

interface Props {
  address: string;
}

const tool = toolAt(Astro.props.address);
---

<SiteLayout
  title={fillText(text.tool.pageTitle, { name: tool.name, siteName: text.siteName })}
  description={tool.blurb}
>
  <a class="back-link" href={sitePath()}>
    <span aria-hidden="true">‹ </span>
    {text.tool.backLink}
  </a>
  <h1>{tool.name}</h1>
  <p>{tool.blurb}</p>
  <p class="privacy-line">{tool.privacyLine}</p>
  <ToolPage client:load address={tool.address} />
</SiteLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    margin-bottom: 0.5rem;
  }

  .privacy-line {
    padding: 0.5rem 0.75rem;
    border-left: 4px solid var(--action);
    background: var(--surface);
  }
</style>
