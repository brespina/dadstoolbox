---
import { text } from '../text';
import { links } from '../links';

// BASE_URL may or may not end in a slash, so join and then collapse any double slash.
const promisePath = `${import.meta.env.BASE_URL}/promise/`.replace(/\/+/g, '/');
---

<footer class="site-footer">
  <nav aria-label={text.footer.label}>
    <ul>
      <li>
        <a href={promisePath}>{text.footer.promise}</a>
      </li>
      <li>
        <a href={links.reportProblem}>{text.footer.reportProblem}</a>
      </li>
      <li>
        <a href={links.sponsor}>{text.footer.sponsor}</a>
      </li>
    </ul>
  </nav>
</footer>
